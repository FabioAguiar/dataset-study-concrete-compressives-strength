# ============================================
# ⚙️ SISTEMA / EDITORES
# ============================================
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# ============================================
# 🐍 PYTHON / AMBIENTE LOCAL
# ============================================
__pycache__/
*.py[cod]
.venv/
venv/
env/
dist/
build/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ============================================
# 📓 JUPYTER NOTEBOOKS
# ============================================
# Official notebooks are versioned executed; only checkpoints and nbconvert
# side copies are local.
.ipynb_checkpoints/
*.nbconvert.ipynb

# ============================================
# 🔒 VARIÁVEIS DE AMBIENTE / CREDENCIAIS
# ============================================
.env
.env.*
*.env
secrets.*
credentials.*

# ============================================
# 📁 DADOS (materializados localmente)
# ============================================
# The raw source is pinned by contracts/source.json and acquired from UCI;
# processed data is regenerated by Notebook 02.
data/raw/
data/interim/
data/processed/

# ============================================
# 🧱 ARTEFATOS DE EXECUÇÃO (regenerados pelos notebooks)
# ============================================
artifacts/**/*.json
artifacts/**/*.csv
artifacts/**/*.parquet
*.joblib
*.pkl
*.pickle

# ============================================
# 🧪 LOGS / TEMPORÁRIOS / BACKUPS
# ============================================
*.log
*.bak
*.bak-*
*.tmp
*.temp
*.old
*_backup.*
~$*
